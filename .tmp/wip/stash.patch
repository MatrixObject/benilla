+/// Copy the recorded frames out, oldest first. `out` receives
+/// `min(count, cap / MOVE_DBG_STRIDE)` rows of [`MOVE_DBG_STRIDE`] f32 each;
+/// returns the row count written.
+#[no_mangle]
+pub extern "C" fn bn_player_move_debug(world: *const BnWorld, out: *mut f32, cap: u32) -> u32 {
+    if world.is_null() || out.is_null() {
+        return 0;
+    }
+    let w = unsafe { &*world };
+    let Some(p) = w.player.as_ref() else { return 0 };
+    let rows = p.dbg.rec.len().min((cap as usize) / MOVE_DBG_STRIDE);
+    for (i, r) in p.dbg.rec.iter().take(rows).enumerate() {
+        let base = i * MOVE_DBG_STRIDE;
+        // SAFETY: the caller passes room for `rows * MOVE_DBG_STRIDE` floats.
+        unsafe {
+            for (k, v) in r.iter().enumerate() {
+                *out.add(base + k) = *v;
+            }
+        }
+    }
+    rows as u32
+}
