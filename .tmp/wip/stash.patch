+    /// The deepest steep face the capsule already overlaps, with that face's
+    /// group/source and vertices. Read-only; the matrix probe and the per-event
+    /// record both use this one rule.
+    fn penetration(&self) -> PenInfo {
+        let feet = self.pos[2];
+        let lo = feet + CAPSULE_RADIUS;
+        let hi = feet + CAPSULE_HEIGHT - CAPSULE_RADIUS;
+        let r = CAPSULE_RADIUS;
+        let mut out = PenInfo::default();
+        let mut nearest = f32::MAX;
+        let mut faces = 0f32;
+        for k in 0..3 {
+            let q = [self.pos[0], self.pos[1], lo + (hi - lo) * (k as f32 / 2.0)];
+            self.any_tri_near(q, |t| {
+                if t.n[2].abs() >= GROUND_COS {
+                    return false; // a floor or a ceiling
+                }
+                let top = t.v[0][2].max(t.v[1][2]).max(t.v[2][2]);
+                if top <= feet + STEP_UP_HEIGHT {
+                    return false; // a curb the mover steps over
+                }
+                let c = closest_on_tri(q, t);
+                let d = ((q[0] - c[0]).powi(2) + (q[1] - c[1]).powi(2) + (q[2] - c[2]).powi(2))
+                    .sqrt();
+                if d < nearest {
+                    nearest = d;
+                }
+                if d < r {
+                    faces += 1.0;
+                }
+                let depth = r - d;
+                if depth > out.depth {
+                    out.depth = depth;
+                    out.n = t.n;
+                    out.top = top;
+                    out.src = t.src;
+                    out.grp = t.grp;
+                    out.v = t.v;
+                }
+                false
+            });
+        }
+        out.nearest = if nearest < f32::MAX { nearest } else { -1.0 };
+        out.faces = faces;
+        out
+    }
